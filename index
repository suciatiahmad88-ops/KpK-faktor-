        }

        function setAvatar(emoji) {
            state.avatar = emoji;
            document.getElementById('user-avatar').innerText = emoji;
            playSound('pop');
        }

        // Simulation Engine: Prime Factor Trees & LCM Calculator
        function getPrimeFactors(n) {
            const factors = [];
            let divisor = 2;
            let current = n;
            while (current >= 2) {
                if (current % divisor === 0) {
                    factors.push(divisor);
                    current /= divisor;
                } else {
                    divisor++;
                }
            }
            return factors;
        }

        function formatFactorization(factors) {
            const counts = {};
            factors.forEach(x => counts[x] = (counts[x] || 0) + 1);
            return Object.keys(counts).map(p => {
                return counts[p] > 1 ? `${p}<sup>${counts[p]}</sup>` : `${p}`;
            }).join(' × ');
        }

        function runSimulation() {
            const numA = parseInt(document.getElementById('sim-num-1').value);
            const numB = parseInt(document.getElementById('sim-num-2').value);

            document.getElementById('sim-title-a').innerText = numA;
            document.getElementById('sim-title-b').innerText = numB;

            const factorsA = getPrimeFactors(numA);
            const factorsB = getPrimeFactors(numB);

            document.getElementById('sim-fact-a-badge').innerHTML = formatFactorization(factorsA);
            document.getElementById('sim-fact-b-badge').innerHTML = formatFactorization(factorsB);

            // Render visual trees
            renderVisualTree('sim-tree-a-container', numA, factorsA, 'amber');
            renderVisualTree('sim-tree-b-container', numB, factorsB, 'sky');

            // Calculate LCM
            const countsA = {}, countsB = {};
            factorsA.forEach(x => countsA[x] = (countsA[x] || 0) + 1);
            factorsB.forEach(x => countsB[x] = (countsB[x] || 0) + 1);

            const allPrimes = new Set([...Object.keys(countsA), ...Object.keys(countsB)]);
            let lcm = 1;
            let detailParts = [];
            let maxPowerParts = [];

            allPrimes.forEach(p => {
                const pNum = parseInt(p);
                const expA = countsA[pNum] || 0;
                const expB = countsB[pNum] || 0;
                const maxExp = Math.max(expA, expB);
                lcm *= Math.pow(pNum, maxExp);

                detailParts.push(`Faktor <strong>${pNum}</strong>: terdapat di A (${expA}x) & B (${expB}x).`);
                maxPowerParts.push(`${pNum}<sup>${maxExp}</sup>`);
            });

            document.getElementById('sim-compare-detail').innerHTML = detailParts.join('<br>');
            document.getElementById('sim-max-powers').innerHTML = maxPowerParts.join(' × ');
            document.getElementById('sim-kpk-result').innerText = lcm;
        }

        function renderVisualTree(containerId, number, factors, colorTheme) {
            const container = document.getElementById(containerId);
            let html = `<div class="flex flex-col items-center gap-2">`;
            html += `<div class="w-12 h-12 bg-${colorTheme}-500 text-white font-bold rounded-2xl flex items-center justify-center text-lg title-font shadow-md">${number}</div>`;
            
            let current = number;
            factors.forEach((f, idx) => {
                if (idx < factors.length - 1) {
                    const nextVal = current / f;
                    html += `<div class="text-xs font-bold text-slate-400">↓ dibagi ${f}</div>`;
                    html += `<div class="flex gap-4">
