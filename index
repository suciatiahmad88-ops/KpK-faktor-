<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Petualangan KPK - Media Pembelajaran Interaktif Kelas 5 SD</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Fredoka & Plus Jakarta Sans for cute friendly theme -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif']
                    },
                    colors: {
                        brand: {
                            yellow: '#FFC72C',
                            orange: '#FF8A00',
                            blue: '#4A90E2',
                            green: '#2ECC71',
                            purple: '#9B59B6',
                            red: '#E74C3C',
                            lightBg: '#F7FAFC'
                        }
                    },
                    boxShadow: {
                        'game': '0 8px 0px 0px rgba(0,0,0,0.15)',
                        'game-sm': '0 4px 0px 0px rgba(0,0,0,0.12)',
                        'game-pressed': '0 2px 0px 0px rgba(0,0,0,0.2)'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F3F4F6;
            user-select: none;
            -webkit-user-select: none;
        }
        .title-font {
            font-family: 'Fredoka', cursive;
        }
        .card-bounce {
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .card-bounce:hover {
            transform: translateY(-4px) scale(1.02);
        }
        .tree-line {
            stroke: #4B5563;
            stroke-width: 3;
            stroke-dasharray: 4;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }
        .pulse-anim {
            animation: pulse-ring 2s infinite ease-in-out;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- Top Bar Navigation -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b-4 border-amber-300 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <!-- Logo & Title -->
                <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('beranda')">
                    <div class="bg-amber-400 text-white p-3 rounded-2xl shadow-game-sm transform -rotate-3">
                        <i class="fa-solid fa-calculator text-2xl sm:text-3xl"></i>
                    </div>
                    <div>
                        <h1 class="title-font text-xl sm:text-2xl font-bold text-slate-800 tracking-wide flex items-center gap-2">
                            Petualangan <span class="text-amber-500">KPK</span> 🚀
                        </h1>
                        <p class="text-xs text-slate-500 font-semibold hidden sm:block">Matematika SD Kelas 5 - Faktorisasi Prima</p>
                    </div>
                </div>

                <!-- Score & Progress Indicator -->
                <div class="flex items-center gap-3 bg-amber-50 px-3 py-1.5 sm:px-4 sm:py-2 rounded-2xl border-2 border-amber-200">
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-star text-amber-500 text-lg sm:text-xl"></i>
                        <span id="global-score" class="title-font font-bold text-lg sm:text-xl text-amber-600">0</span>
                    </div>
                    <div class="h-6 w-0.5 bg-amber-200"></div>
                    <div class="flex items-center gap-1.5">
                        <span id="level-badge" class="px-2 py-0.5 bg-amber-200 text-amber-800 font-bold text-xs rounded-full title-font">
                            Level: Pemula
                        </span>
                    </div>
                </div>
            </div>

            <!-- Main Navigation Tabs -->
            <nav class="flex justify-center sm:justify-start overflow-x-auto py-2 gap-1 sm:gap-2 no-scrollbar text-xs sm:text-sm font-semibold">
                <button onclick="switchTab('beranda')" id="tab-beranda" class="nav-btn active flex items-center gap-2 px-3 sm:px-4 py-2 rounded-xl transition-all">
                    <i class="fa-solid fa-house"></i> <span>Beranda</span>
                </button>
                <button onclick="switchTab('materi')" id="tab-materi" class="nav-btn flex items-center gap-2 px-3 sm:px-4 py-2 rounded-xl transition-all">
                    <i class="fa-solid fa-book-open"></i> <span>Materi</span>
                </button>
                <button onclick="switchTab('simulasi')" id="tab-simulasi" class="nav-btn flex items-center gap-2 px-3 sm:px-4 py-2 rounded-xl transition-all">
                    <i class="fa-solid fa-flask"></i> <span>Simulasi</span>
                </button>
                <button onclick="switchTab('permainan')" id="tab-permainan" class="nav-btn flex items-center gap-2 px-3 sm:px-4 py-2 rounded-xl transition-all">
                    <i class="fa-solid fa-gamepad"></i> <span>Permainan</span>
                </button>
                <button onclick="switchTab('kuis')" id="tab-kuis" class="nav-btn flex items-center gap-2 px-3 sm:px-4 py-2 rounded-xl transition-all">
                    <i class="fa-solid fa-pen-to-square"></i> <span>Kuis</span>
                </button>
                <button onclick="switchTab('hasil')" id="tab-hasil" class="nav-btn flex items-center gap-2 px-3 sm:px-4 py-2 rounded-xl transition-all">
                    <i class="fa-solid fa-trophy"></i> <span>Hasil</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Sound Effects Synthesizer & Modal Overlay Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow w-full">

        <!-- SECTION 1: BERANDA -->
        <section id="sec-beranda" class="tab-content block space-y-6">
            <!-- Hero Banner -->
            <div class="bg-gradient-to-r from-amber-400 via-orange-400 to-rose-400 rounded-3xl p-6 sm:p-10 text-white shadow-xl relative overflow-hidden">
                <div class="relative z-10 max-w-2xl space-y-4">
                    <span class="bg-white/30 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider backdrop-blur-md">
                        🎓 Pembelajaran Interaktif Matematika
                    </span>
                    <h2 class="title-font text-3xl sm:text-5xl font-extrabold tracking-wide leading-tight">
                        Taklukkan KPK dengan Faktorisasi Prima!
                    </h2>
                    <p class="text-amber-50 text-sm sm:text-base leading-relaxed">
                        Halo Petualang Cilik! Mari belajar menemukan **Kelipatan Persekutuan Terkecil (KPK)** dengan cara seru lewat Pohon Faktor, permainan tantangan, dan simulasi ajaib!
                    </p>
                    <div class="pt-2 flex flex-wrap gap-3">
                        <button onclick="switchTab('simulasi')" class="bg-white text-orange-600 font-bold px-6 py-3 rounded-2xl shadow-game hover:bg-amber-50 active:translate-y-1 transition-all flex items-center gap-2 title-font">
                            <i class="fa-solid fa-play"></i> Mulai Simulasi
                        </button>
                        <button onclick="switchTab('materi')" class="bg-orange-600/30 text-white font-bold px-6 py-3 rounded-2xl border-2 border-white/40 hover:bg-orange-600/50 transition-all flex items-center gap-2 title-font">
                            <i class="fa-solid fa-book"></i> Baca Materi
                        </button>
                    </div>
                </div>
                <!-- Cute Decorative Icons -->
                <div class="absolute -right-10 -bottom-10 opacity-20 text-white text-[200px] pointer-events-none hidden md:block">
                    <i class="fa-solid fa-tree"></i>
                </div>
            </div>

            <!-- Profile & Avatar Selector -->
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 grid md:grid-cols-3 gap-6 items-center">
                <div class="space-y-2">
                    <label class="block text-xs font-bold uppercase text-slate-400">Profil Petualang</label>
                    <div class="flex items-center gap-3">
                        <div id="user-avatar" class="w-14 h-14 bg-amber-100 rounded-2xl flex items-center justify-center text-3xl border-2 border-amber-400">
                            🦊
                        </div>
                        <div>
                            <input type="text" id="student-name-input" value="Siswa Hebat" class="font-bold text-lg text-slate-800 border-b-2 border-amber-300 focus:outline-none focus:border-amber-500 bg-transparent w-full" placeholder="Masukkan Namamu...">
                            <p class="text-xs text-slate-500">Kelas 5 SD • Matematika</p>
                        </div>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-bold uppercase text-slate-400">Pilih Avatar Favorit</label>
                    <div class="flex gap-2 text-2xl">
                        <button onclick="setAvatar('🦊')" class="p-2 bg-slate-100 hover:bg-amber-100 rounded-xl transition">🦊</button>
                        <button onclick="setAvatar('🦁')" class="p-2 bg-slate-100 hover:bg-amber-100 rounded-xl transition">🦁</button>
                        <button onclick="setAvatar('🐼')" class="p-2 bg-slate-100 hover:bg-amber-100 rounded-xl transition">🐼</button>
                        <button onclick="setAvatar('🤖')" class="p-2 bg-slate-100 hover:bg-amber-100 rounded-xl transition">🤖</button>
                        <button onclick="setAvatar('🚀')" class="p-2 bg-slate-100 hover:bg-amber-100 rounded-xl transition">🚀</button>
                    </div>
                </div>

                <div class="bg-amber-50 rounded-2xl p-4 border border-amber-200 space-y-1">
                    <div class="flex justify-between text-xs font-bold text-amber-800">
                        <span>Target Kelulusan Materi</span>
                        <span id="overall-progress-text">0%</span>
                    </div>
                    <div class="w-full bg-amber-200 h-3 rounded-full overflow-hidden">
                        <div id="overall-progress-bar" class="bg-amber-500 h-full w-0 transition-all duration-500"></div>
                    </div>
                    <p class="text-[11px] text-amber-700 font-medium">Selesaikan materi, simulasi, dan tantangan untuk mendapatkan Pin Emas!</p>
                </div>
            </div>

            <!-- Target Pembelajaran Cards -->
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-emerald-50 border-2 border-emerald-200 rounded-2xl p-4 flex gap-3 items-start">
                    <div class="p-3 bg-emerald-500 text-white rounded-xl shadow-sm">
                        <i class="fa-solid fa-seedling text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-emerald-900 title-font">Bilangan Prima</h3>
                        <p class="text-xs text-emerald-700 leading-snug">Mengenal bilangan yang hanya punya 2 faktor: 1 dan dirinya sendiri (2, 3, 5, 7...)</p>
                    </div>
                </div>

                <div class="bg-sky-50 border-2 border-sky-200 rounded-2xl p-4 flex gap-3 items-start">
                    <div class="p-3 bg-sky-500 text-white rounded-xl shadow-sm">
                        <i class="fa-solid fa-sitemap text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-sky-900 title-font">Pohon Faktor</h3>
                        <p class="text-xs text-sky-700 leading-snug">Membagi bilangan dengan faktor prima sampai tidak bisa dibagi lagi.</p>
                    </div>
                </div>

                <div class="bg-purple-50 border-2 border-purple-200 rounded-2xl p-4 flex gap-3 items-start">
                    <div class="p-3 bg-purple-500 text-white rounded-xl shadow-sm">
                        <i class="fa-solid fa-calculator text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-purple-900 title-font">Faktorisasi Prima</h3>
                        <p class="text-xs text-purple-700 leading-snug">Menuliskan bilangan dalam bentuk perkalian bilangan-bilangan prima.</p>
                    </div>
                </div>

                <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-4 flex gap-3 items-start">
                    <div class="p-3 bg-amber-500 text-white rounded-xl shadow-sm">
                        <i class="fa-solid fa-bullseye text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-amber-900 title-font">Rumus Emas KPK</h3>
                        <p class="text-xs text-amber-700 leading-snug">Kalikan **semua faktor prima**, jika ada yang sama pilih **pangkat terbesar**!</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: MATERI PEMBELAJARAN -->
        <section id="sec-materi" class="tab-content hidden space-y-6">
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
                <!-- Header -->
                <div class="border-b pb-4 flex items-center justify-between">
                    <div>
                        <span class="text-xs font-bold text-amber-500 uppercase tracking-wide">Panduan Konsep</span>
                        <h2 class="title-font text-2xl sm:text-3xl font-bold text-slate-800">
                            📚 Memahami Faktorisasi Prima & KPK
                        </h2>
                    </div>
                    <button onclick="playSound('pop')" class="px-3 py-1.5 bg-amber-100 text-amber-800 rounded-xl text-xs font-bold">
                        <i class="fa-solid fa-volume-high"></i> Audio Panduan
                    </button>
                </div>

                <!-- Interactive Steps -->
                <div class="grid md:grid-cols-3 gap-6">
                    <!-- Step 1 -->
                    <div class="bg-slate-50 rounded-2xl p-5 border-2 border-slate-200 hover:border-amber-400 transition-all space-y-3">
                        <div class="w-8 h-8 bg-amber-400 text-white font-bold rounded-xl flex items-center justify-center title-font">1</div>
                        <h3 class="font-bold text-lg text-slate-800 title-font">Apa itu Bilangan Prima?</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Bilangan prima adalah bilangan asli yang lebih besar dari 1 dan **hanya memiliki 2 faktor**, yaitu angka **1** dan **bilangan itu sendiri**.
                        </p>
                        <div class="bg-amber-100/60 p-3 rounded-xl text-xs text-amber-900 font-semibold">
                            Contoh Bilangan Prima: <br>
                            <span class="text-amber-700 font-bold text-sm">2, 3, 5, 7, 11, 13, 17, 19, 23...</span>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="bg-slate-50 rounded-2xl p-5 border-2 border-slate-200 hover:border-amber-400 transition-all space-y-3">
                        <div class="w-8 h-8 bg-orange-400 text-white font-bold rounded-xl flex items-center justify-center title-font">2</div>
                        <h3 class="font-bold text-lg text-slate-800 title-font">Membuat Pohon Faktor</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Bagilah bilangan berturut-turut dengan bilangan prima terkecil (2, 3, 5, dst.) hingga hasilnya berupa bilangan prima.
                        </p>
                        <div class="bg-orange-100/60 p-3 rounded-xl text-xs text-orange-900 font-medium">
                            Contoh Pohon Faktor 12: <br>
                            • 12 ÷ <strong class="text-rose-600">2</strong> = 6 <br>
                            • 6 ÷ <strong class="text-rose-600">2</strong> = <strong class="text-rose-600">3</strong> <br>
                            Faktorisasi Prima 12 = <span class="font-bold text-slate-800">2² × 3</span>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="bg-slate-50 rounded-2xl p-5 border-2 border-slate-200 hover:border-amber-400 transition-all space-y-3">
                        <div class="w-8 h-8 bg-emerald-500 text-white font-bold rounded-xl flex items-center justify-center title-font">3</div>
                        <h3 class="font-bold text-lg text-slate-800 title-font">Aturan Rahasia KPK</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            KPK singkatan dari Kelipatan Persekutuan Terkecil. Kuncinya:
                        </p>
                        <div class="bg-emerald-100/80 p-3 rounded-xl text-xs text-emerald-900 font-semibold space-y-1">
                            <p class="flex items-center gap-1.5"><i class="fa-solid fa-check text-emerald-600"></i> Ambil <strong>semua faktor prima</strong>.</p>
                            <p class="flex items-center gap-1.5"><i class="fa-solid fa-check text-emerald-600"></i> Jika ada faktor sama, pilih <strong>pangkat terbesar</strong>!</p>
                        </div>
                    </div>
                </div>

                <!-- Example Case Study -->
                <div class="bg-gradient-to-br from-indigo-50 to-sky-50 rounded-2xl p-6 border-2 border-indigo-100 space-y-4">
                    <h3 class="font-bold text-indigo-900 text-lg title-font flex items-center gap-2">
                        💡 Contoh Studi Kasus Ringkas
                    </h3>
                    <div class="grid md:grid-cols-2 gap-4 text-xs">
                        <div class="bg-white p-4 rounded-xl border border-indigo-100 shadow-sm space-y-2">
                            <p class="font-bold text-slate-700">Soal: Tentukan KPK dari 12 dan 18!</p>
                            <ol class="list-decimal list-inside space-y-1 text-slate-600">
                                <li>Faktorisasi Prima 12 = <span class="font-bold text-amber-600">2² × 3</span></li>
                                <li>Faktorisasi Prima 18 = <span class="font-bold text-sky-600">2 × 3²</span></li>
                                <li>Faktor prima yang muncul: <strong>2</strong> dan <strong>3</strong></li>
                                <li>Pangkat terbesar faktor 2 adalah <span class="bg-amber-100 px-1 font-bold">2²</span></li>
                                <li>Pangkat terbesar faktor 3 adalah <span class="bg-sky-100 px-1 font-bold">3²</span></li>
                            </ol>
                        </div>

                        <div class="bg-white p-4 rounded-xl border border-indigo-100 shadow-sm flex flex-col justify-between space-y-3">
                            <p class="font-bold text-slate-700">Hasil Akhir Perhitungan KPK:</p>
                            <div class="bg-emerald-50 p-3 rounded-xl border border-emerald-200 text-center">
                                <span class="text-xs text-emerald-700 font-bold">KPK(12, 18) = 2² × 3²</span>
                                <div class="text-2xl font-black text-emerald-600 title-font mt-1">
                                    4 × 9 = 36
                                </div>
                            </div>
                            <p class="text-[11px] text-slate-500 italic">
                                Artinya, angka 36 adalah kelipatan terkecil yang bisa dibagi habis oleh 12 maupun 18!
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 3: SIMULASI INTERAKTIF -->
        <section id="sec-simulasi" class="tab-content hidden space-y-6">
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
                <!-- Title -->
                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b pb-4">
                    <div>
                        <span class="text-xs font-bold text-indigo-500 uppercase tracking-wide">Laboratorium Matematika</span>
                        <h2 class="title-font text-2xl sm:text-3xl font-bold text-slate-800">
                            🔬 Laboratorium Mesin Pohon Faktor & KPK
                        </h2>
                    </div>
                    <p class="text-xs text-slate-500 max-w-xs">
                        Pilih 2 angka di bawah ini untuk melihat pohon faktor, faktorisasi prima, dan pembentukan KPK secara otomatis!
                    </p>
                </div>

                <!-- Controls -->
                <div class="bg-amber-50 p-4 sm:p-6 rounded-2xl border border-amber-200 grid sm:grid-cols-3 gap-4 items-center">
                    <div>
                        <label class="block text-xs font-bold text-amber-900 mb-1">Bilangan Pertama (A):</label>
                        <select id="sim-num-1" onchange="runSimulation()" class="w-full bg-white font-bold text-slate-800 p-3 rounded-xl border-2 border-amber-300 focus:outline-none focus:border-amber-500 title-font text-lg">
                            <option value="12">12</option>
                            <option value="15">15</option>
                            <option value="18">18</option>
                            <option value="20">20</option>
                            <option value="24" selected>24</option>
                            <option value="30">30</option>
                            <option value="36">36</option>
                            <option value="40">40</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-amber-900 mb-1">Bilangan Kedua (B):</label>
                        <select id="sim-num-2" onchange="runSimulation()" class="w-full bg-white font-bold text-slate-800 p-3 rounded-xl border-2 border-amber-300 focus:outline-none focus:border-amber-500 title-font text-lg">
                            <option value="12">12</option>
                            <option value="18">18</option>
                            <option value="20">20</option>
                            <option value="30">30</option>
                            <option value="36" selected>36</option>
                            <option value="40">40</option>
                            <option value="45">45</option>
                            <option value="60">60</option>
                        </select>
                    </div>

                    <div class="sm:pt-5">
                        <button onclick="runSimulation()" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-xl shadow-game hover:shadow-game-sm transition-all title-font flex items-center justify-center gap-2">
                            <i class="fa-solid fa-rotate-right"></i> Generasi Pohon Faktor
                        </button>
                    </div>
                </div>

                <!-- Simulation Visual Output Grid -->
                <div class="grid md:grid-cols-2 gap-6">
                    <!-- Tree 1 -->
                    <div class="bg-slate-50 p-5 rounded-2xl border-2 border-slate-200 space-y-3">
                        <div class="flex justify-between items-center border-b pb-2">
                            <h4 class="title-font font-bold text-slate-800 text-lg">
                                Pohon Faktor Bilangan <span id="sim-title-a" class="text-amber-600 font-extrabold">24</span>
                            </h4>
                            <span id="sim-fact-a-badge" class="bg-amber-100 text-amber-800 text-xs font-bold px-2.5 py-1 rounded-full">2³ × 3</span>
                        </div>
                        <div id="sim-tree-a-container" class="min-h-[220px] flex flex-col items-center justify-center py-4 overflow-x-auto">
                            <!-- Dynamically generated tree SVG or HTML nodes -->
                        </div>
                    </div>

                    <!-- Tree 2 -->
                    <div class="bg-slate-50 p-5 rounded-2xl border-2 border-slate-200 space-y-3">
                        <div class="flex justify-between items-center border-b pb-2">
                            <h4 class="title-font font-bold text-slate-800 text-lg">
                                Pohon Faktor Bilangan <span id="sim-title-b" class="text-sky-600 font-extrabold">36</span>
                            </h4>
                            <span id="sim-fact-b-badge" class="bg-sky-100 text-sky-800 text-xs font-bold px-2.5 py-1 rounded-full">2² × 3²</span>
                        </div>
                        <div id="sim-tree-b-container" class="min-h-[220px] flex flex-col items-center justify-center py-4 overflow-x-auto">
