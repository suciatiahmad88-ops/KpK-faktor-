            playSound('pop');
            document.querySelectorAll('.quiz-sub-sec').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.quiz-sub-btn').forEach(btn => {
                btn.classList.remove('bg-amber-400', 'text-white');
                btn.classList.add('bg-slate-100', 'text-slate-600');
            });

            document.getElementById(`quiz-sec-${type}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`quiz-btn-${type}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-amber-400', 'text-white');
                activeBtn.classList.remove('bg-slate-100', 'text-slate-600');
            }

            if (type === 'pg') initQuizPG();
            if (type === 'fill') initQuizFill();
            if (type === 'tf') initQuizTF();
        }

        function updateGlobalScore() {
            state.globalScore = Object.values(state.scores).reduce((a, b) => a + b, 0);
            document.getElementById('global-score').innerText = state.globalScore;

            // Level Progression
            const levelBadge = document.getElementById('level-badge');
            if (state.globalScore < 120) {
                levelBadge.innerText = "Level: Pemula";
                levelBadge.className = "px-2 py-0.5 bg-amber-200 text-amber-800 font-bold text-xs rounded-full title-font";
            } else if (state.globalScore < 300) {
                levelBadge.innerText = "Level: Sedang";
                levelBadge.className = "px-2 py-0.5 bg-sky-200 text-sky-800 font-bold text-xs rounded-full title-font";
            } else {
                levelBadge.innerText = "Level: Pakar KPK";
                levelBadge.className = "px-2 py-0.5 bg-emerald-200 text-emerald-800 font-bold text-xs rounded-full title-font";
            }

            // Global progress bar calculation (Total max points = ~550)
            const progress = Math.min(100, Math.round((state.globalScore / 500) * 100));
            document.getElementById('overall-progress-bar').style.width = `${progress}%`;
            document.getElementById('overall-progress-text').innerText = `${progress}%`;
        }

        function updateSummaryPage() {
            document.getElementById('summary-total-score').innerText = state.globalScore;
            document.getElementById('score-breakdown-box').innerText = `${state.scores.openTheBox} / 100`;
            document.getElementById('score-breakdown-drag').innerText = `${state.scores.dragDrop} / 100`;
            document.getElementById('score-breakdown-match').innerText = `${state.scores.menjodohkan} / 100`;
            document.getElementById('score-breakdown-quiz').innerText = `${state.scores.pg + state.scores.fill + state.scores.tf} / 150`;
            document.getElementById('score-breakdown-ta').innerText = `${state.scores.tantangan} / 100`;

            const emo = document.getElementById('motivation-emoji');
            const title = document.getElementById('motivation-title');
            const body = document.getElementById('motivation-body');

            if (state.globalScore >= 350) {
                emo.innerText = "🏆";
                title.innerText = "Luar Biasa! Master Matematika!";
                body.innerText = "Selamat! Kamu telah menguasai konsep faktorisasi prima dan KPK dengan sangat sempurna! Pertahankan prestasimu!";
            } else if (state.globalScore >= 150) {
                emo.innerText = "🌟";
                title.innerText = "Hebat! Terus Tingkatkan!";
                body.innerText = "Kamu sudah memahami langkah dasar KPK dengan sangat baik. Mari coba latihan lagi untuk mendapatkan skor maksimal!";
            } else {
                emo.innerText = "🌱";
                title.innerText = "Ayo Semangat Belajar!";
                body.innerText = "Jangan menyerah! Buka materi dan coba permainan simulasi interaktif untuk lebih memahami rumus KPK!";
            }

            // Render Badges
            const badges = [
                { title: "Detektif Prima", desc: "Membuka Open The Box", active: state.scores.openTheBox > 0, icon: "🔍" },
                { title: "Penyusun Pohon", desc: "Selesaikan Drag & Drop", active: state.scores.dragDrop >= 60, icon: "🌳" },
                { title: "Jagoan Pasangan", desc: "Menjodohkan Sempurna", active: state.scores.menjodohkan >= 80, icon: "🔗" },
                { title: "Pakar Kuis", desc: "Kuis Total > 100 pt", active: (state.scores.pg + state.scores.fill + state.scores.tf) >= 100, icon: "👑" }
            ];

            const grid = document.getElementById('badge-collection-grid');
            grid.innerHTML = badges.map(b => `
                <div class="p-4 rounded-2xl border-2 ${b.active ? 'bg-amber-50 border-amber-300 text-amber-900' : 'bg-slate-100 border-slate-200 text-slate-400 opacity-60'} text-center space-y-1">
                    <div class="text-3xl">${b.icon}</div>
                    <h5 class="font-bold text-xs title-font">${b.title}</h5>
                    <p class="text-[10px] leading-tight">${b.desc}</p>
                </div>
            `).join('');
        }

        function showToast(msg) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = "bg-slate-800 text-white px-4 py-2 rounded-xl text-xs font-bold shadow-lg flex items-center gap-2 transition-all duration-300";
            toast.innerHTML = `<i class="fa-solid fa-bell text-amber-400"></i> ${msg}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function resetAllProgress() {
            if (confirm("Apakah kamu yakin ingin mengulang semua nilai dan permainan dari awal?")) {
                state.globalScore = 0;
                Object.keys(state.scores).forEach(k => state.scores[k] = 0);
                state.boxOpened = [false, false, false, false, false];
                updateGlobalScore();
                switchTab('beranda');
                showToast("Progress telah direset dari awal.");
            }
        }

        // Window Load Initialization
        window.onload = function() {
            runSimulation();
            initOpenTheBox();
            initDragDrop();
            initMenjodohkan();
            initQuizPG();
            
            // Sync Name input
            const nameInput = document.getElementById('student-name-input');
            if (nameInput) {
                nameInput.addEventListener('input', (e) => {
                    state.studentName = e.target.value || "Siswa Hebat";
                });
            }
        };
    </script>
</body>
</html>